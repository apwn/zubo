{
  "name": "zubo",
  "version": "0.1.13",
  "description": "Your AI agent that never forgets. Persistent memory, 25+ tools, 7 channels, 11+ LLM providers — runs entirely on your machine.",
  "license": "MIT",
  "author": "thomaskanze",
  "homepage": "https://zubo.bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/apwn/zubo.git"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "chatbot",
    "memory",
    "tools",
    "bun",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "zubo": "src/index.ts"
  },
  "scripts": {
    "setup": "bun run src/index.ts setup",
    "start": "bun run src/index.ts start",
    "start:daemon": "bun run src/index.ts start --daemon",
    "stop": "bun run src/index.ts stop",
    "status": "bun run src/index.ts status",
    "logs": "bun run src/index.ts logs",
    "logs:follow": "bun run src/index.ts logs --follow",
    "model": "bun run src/index.ts model",
    "skills": "bun run src/index.ts skills",
    "dev": "bun run --watch src/index.ts start",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:build": "cd desktop && npm run build",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "croner": "^9.0.0",
    "discord.js": "^14.25.1",
    "grammy": "^1.35.0",
    "onnxruntime-node": "^1.24.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "onnxruntime-node"
  ]
}
